:root{
  --navy:#0a1c33;
  --navy-2:#112c52;
  --gold:#c9a227;
  --gold-soft:#e6d7a3;
  --ink:#1c2430;
  --muted:#5c6673;
  --line:#d7dbe2;
  --panel:#f7f6f2;
  --link:#0b4da2;
  --max: 1160px;
  --pad: 18px;
}
.section-divider{
  height:4px;
  background:var(--gold);
  margin:6px 0 18px .button.disabled{
  background:#cfd6df;
  border-color:#cfd6df;
  color:#243244;
  pointer-events:none;
  cursor:not-allowed;
}
.small{font-size:13px;color:var(--muted);}
.kv{margin:8px 0 0 0; padding:0; list-style:none;}
.kv li{padding:3px 0; border-bottom:1px solid var(--line);}
.kv li:last-child{border-bottom:none;}
